#!/usr/bin/env bash

# The NVIDIA GPU and the Studio Display's Thunderbolt/USB hub do not resume
# synchronously. Wait for a Wayland output before cycling DPMS to clear the
# stale console frame; enabling an already-enabled output can leave it stuck.
for attempt in {1..20}; do
  if hyprctl monitors -j 2>/dev/null | grep -q '"name"'; then
    break
  fi
  sleep 0.5
done

# Try the cycle even if output enumeration timed out.
hyprctl dispatch 'hl.dsp.dpms({action = "off"})'
sleep 0.5
hyprctl dispatch 'hl.dsp.dpms({action = "on"})'
