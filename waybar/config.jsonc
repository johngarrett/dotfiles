{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 8,
  "modules-left": ["hyprland/workspaces"],
  "modules-center": [],
  "modules-right": ["custom/grayscale", "custom/blue-light", "idle_inhibitor", "pulseaudio", "network", "cpu", "memory", "temperature", "clock", "tray", "custom/sleep", "custom/power"],

  "hyprland/workspaces": {
    "all-outputs": false,
    "disable-scroll": true,
    "format": "{name}"
  },
  "custom/grayscale": {
    "exec": "screen-filter status grayscale",
    "return-type": "json",
    "interval": "once",
    "on-click": "screen-filter toggle grayscale",
    "on-scroll-up": "screen-filter adjust grayscale 5",
    "on-scroll-down": "screen-filter adjust grayscale -5"
  },
  "custom/blue-light": {
    "exec": "screen-filter status blue-light",
    "return-type": "json",
    "interval": "once",
    "on-click": "screen-filter toggle blue-light",
    "on-scroll-up": "screen-filter adjust blue-light 5",
    "on-scroll-down": "screen-filter adjust blue-light -5"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
    "tooltip-format-activated": "Idle lock inhibited",
    "tooltip-format-deactivated": "Idle lock enabled"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "muted 󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "pavucontrol"
  },
  "network": {
    "interval": 5,
    "format-wifi": "{ipaddr} 󰖩",
    "format-ethernet": "{ipaddr} 󰈀",
    "format-disconnected": "offline 󰖪",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "on-click": "alacritty -e nmtui"
  },
  "cpu": { "interval": 2, "format": "{usage}% CPU", "tooltip": false },
  "memory": { "interval": 2, "format": "{avail}G free", "tooltip-format": "{used:0.1f}G used of {total:0.1f}G" },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 60,
    "critical-threshold": 80,
    "format": "{temperatureC}°C",
    "format-warning": "{temperatureC}°C",
    "format-critical": "{temperatureC}°C!",
    "tooltip-format": "i7-6700K package: {temperatureC}°C\nGreen <60 · Amber 60–79 · Red ≥80"
  },
  "clock": {
    "interval": 5,
    "format": "{:%m/%d  %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": { "icon-size": 18, "spacing": 8 },
  "custom/sleep": {
    "format": "󰤄",
    "tooltip": true,
    "tooltip-format": "Suspend",
    "on-click": "loginctl lock-session && systemctl suspend"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "session-menu"
  }
}
