{
  "layer": "top",
  "position": "top",
  "height": 40,
  "margin-top": 10,
  "margin-left": 4,
  "margin-right": 4,
  "spacing": 8,
  "modules-left": ["ext/workspaces"],
  "modules-center": [],
  "modules-right": ["custom/grayscale", "custom/blue-light", "pulseaudio", "network", "cpu", "custom/memory", "temperature", "custom/weather", "clock", "tray", "idle_inhibitor"],

  "ext/workspaces": {
    "all-outputs": false,
    "on-click": "activate",
    "format": "{name}"
  },
  "custom/grayscale": {
    "exec": "screen-filter status grayscale",
    "return-type": "json",
    "interval": "once",
    "on-click": "screen-filter toggle grayscale",
    "on-scroll-up": "screen-filter adjust grayscale 5",
    "on-scroll-down": "screen-filter adjust grayscale -5"
  },
  "custom/blue-light": {
    "exec": "screen-filter status blue-light",
    "return-type": "json",
    "interval": "once",
    "on-click": "screen-filter toggle blue-light",
    "on-scroll-up": "screen-filter adjust blue-light 5",
    "on-scroll-down": "screen-filter adjust blue-light -5"
  },
  "pulseaudio": {
    "format": "{volume}% {icon}",
    "format-muted": "muted 󰖁",
    "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
    "scroll-step": 5,
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "pavucontrol"
  },
  "network": {
    "interval": 5,
    "format-wifi": "{ipaddr}",
    "format-ethernet": "{ipaddr} 󰈀",
    "format-disconnected": "offline 󰖪",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "on-click": "alacritty -e nmtui"
  },
  "cpu": {
    "interval": 2,
    "format": "{usage}% CPU",
    "tooltip": false,
    "states": { "warning": 70, "critical": 90 }
  },
  "custom/memory": {
    "exec": "python3 $HOME/.config/waybar/memory.py",
    "return-type": "json",
    "interval": 2
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "warning-threshold": 60,
    "critical-threshold": 80,
    "format": "{temperatureC}°C",
    "format-warning": "{temperatureC}°C",
    "format-critical": "{temperatureC}°C!",
    "tooltip-format": "i7-6700K package: {temperatureC}°C\nGreen <60 · Amber 60–79 · Red ≥80"
  },
  "custom/weather": {
    "exec": "python3 $HOME/.config/waybar/weather.py",
    "return-type": "json",
    "interval": 600
  },
  "clock": {
    "interval": 5,
    "format": "<span text_transform='lowercase'><i>{:%A, %b %e</i>  %I:%M %p}</span>",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
  },
  "tray": { "icon-size": 18, "spacing": 8 },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": { "activated": "󰅶", "deactivated": "󰾪" },
    "tooltip-format-activated": "Idle lock inhibited",
    "tooltip-format-deactivated": "Idle lock enabled"
  }
}
